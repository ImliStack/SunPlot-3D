// Cloudflare Workers deploy: worker/index.js answers /api/* (PVGIS proxy with edge caching) and
// serves the Vite build in dist/ for everything else. No secrets are needed.
{
  "name": "sunplot-3d",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
